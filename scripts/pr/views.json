{
  "$comment": "Fixed camera views captured for every PR (screenshot + perf sample each). Add a view that frames your feature. 'pose' needs the in-app debug API (src/dev/debug.ts); builds without it skip posed views. Player y=1 is standing on the ground (eye at 1.65). Optional 'eval' is JS run in the page after posing (e.g. to trigger an effect); keep it a no-op on builds that lack it. Views run in order on one page, so put views that leave things running last.",
  "views": [
    { "name": "menu", "phase": "menu" },
    { "name": "spawn", "phase": "playing" },
    { "name": "spawn-spraying", "phase": "playing", "spray": true },
    { "name": "yard-overview", "phase": "playing", "pose": { "pos": [12, 1, 12], "lookAt": [0, 1, -4] } },
    { "name": "house-closeup-spraying", "phase": "playing", "spray": true, "pose": { "pos": [0, 1, 1.5], "lookAt": [0, 1.5, -3] } },
    { "name": "driveway-spraying", "phase": "playing", "spray": true, "pose": { "pos": [7, 1, 6.5], "lookAt": [7, 0, 1] } },
    { "name": "fence-closeup", "phase": "playing", "pose": { "pos": [-4.5, 1, 4], "lookAt": [-7, 0.6, 1.5] } },
    { "name": "perimeter-wall", "phase": "playing", "pose": { "pos": [-10, 1, -11], "lookAt": [-6, 0.8, -15] } },
    { "name": "house-corner", "phase": "playing", "pose": { "pos": [10, 1, 4], "lookAt": [0, 2.5, -6] } },
    { "name": "house-door-spraying", "phase": "playing", "spray": true, "pose": { "pos": [1.5, 1, 0], "lookAt": [1.5, 1.8, -3] } },
    {
      "name": "wall-celebration",
      "phase": "playing",
      "pose": { "pos": [1.5, 1, 4], "lookAt": [0, 1.5, -3] },
      "eval": "setInterval(() => window.__pwc.celebrate?.('house-front'), 800)",
      "settleMs": 600
    }
  ]
}
